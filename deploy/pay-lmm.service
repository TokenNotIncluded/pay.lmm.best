[Unit]
Description=pay.lmm.best payment gateway protocol aggregation service
Documentation=https://github.com/TokenNotIncluded/pay.lmm.best
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pay.lmm.best/config.toml
ConditionPathExists=/etc/pay.lmm.best/secrets.env

[Service]
Type=simple
User=pay-lmm
Group=pay-lmm
WorkingDirectory=/var/lib/pay-lmm
EnvironmentFile=/etc/pay.lmm.best/secrets.env
ExecStart=/usr/bin/pay-lmm --config /etc/pay.lmm.best/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pay-lmm
StateDirectory=pay-lmm
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
TasksMax=32
LimitNOFILE=1024
MemoryMax=256M

[Install]
WantedBy=multi-user.target
