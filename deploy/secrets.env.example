# Copy to /etc/pay.lmm.best/secrets.env, owned by root and mode 0600.
# Generate independent random API/webhook secrets; do not use these placeholders.
# Use NAME='value' shell assignments, without export, commands or substitutions.
# RSA PEM may use literal \n escapes, as accepted by the application.
PAY_APP_API_KEY='REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES'
PAY_APP_WEBHOOK_SECRET='REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET'
EPAY_KEY='REPLACE_WITH_UPSTREAM_MERCHANT_KEY'
